# Synapsed app URL (local dev or deployed)
SYNAPSED_BASE_URL=http://localhost:3000

# Target class for study pipeline (create manually or via seed API)
STUDY_CLASS_ID=

# Professor user ID — required only when seed API creates a new class
STUDY_PROFESSOR_ID=

# Must match STUDY_API_KEY in the Next.js app .env
STUDY_API_KEY=change-me-in-production
