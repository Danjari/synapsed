# Synapsed app URL — only needed for DB-backed scripts (03, 04, 06, 07)
SYNAPSED_BASE_URL=http://localhost:3000

# Gemini — pathway generation (07_generate_pathways_offline.py)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview

# Anthropic Claude — LLM-as-judge only (09_research_evaluation.py)
ANTHROPIC_API_KEY=
CLAUDE_JUDGE_MODEL=claude-sonnet-4-6

# Rate limiting — pause between requests; retries use exponential backoff on 429
API_DELAY_SEC=2.0
API_MAX_RETRIES=8
API_BACKOFF_BASE_SEC=5.0
API_BACKOFF_MAX_SEC=120.0

# DB-backed pipeline only (optional)
STUDY_CLASS_ID=
STUDY_PROFESSOR_ID=
STUDY_API_KEY=change-me-in-production
