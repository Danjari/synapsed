# Synapsed app URL — only needed for DB-backed scripts (03, 04, 06, 07)
SYNAPSED_BASE_URL=http://localhost:3000

# Gemini — required for offline pathway generation (07) and evaluation judge (09)
# Can copy from repo root .env if not set here
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
# Optional: use a different model for LLM-as-judge to reduce same-model bias
GEMINI_JUDGE_MODEL=

# DB-backed pipeline only (optional)
STUDY_CLASS_ID=
STUDY_PROFESSOR_ID=
STUDY_API_KEY=change-me-in-production
