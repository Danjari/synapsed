// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init
// after you change this you need to run npx prisma generate 

generator client {
  provider = "prisma-client-js"
  
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  role          Role?
  accounts      Account[]
  sessions      Session[]
  createdAt     DateTime  @default(now()) @map("created_at")

  // relations 

  classesTaught Class[]   @relation("ProfessorClasses")

  enrollments ClassEnrollment[]

  surveyResponses StudentSurveyResponse[]

  // Flashcard progress
  nodeProgress NodeProgress[]

  // Lesson notes authored by the user
  lessonNotes LessonNote[]

  // New relations for content management
  documents    Document[] @relation("UserDocuments")
  notes        Note[]     @relation("UserNotes")
  
  // AI Tutor conversations
  conversations Conversation[]
  
  // In-Chat Assessment responses
  inChatAssessmentResponses InChatAssessmentResponse[]
  
  // Professor Quiz relations
  professorQuizzes ProfessorQuiz[]
  professorQuizResponses ProfessorQuizResponse[]
}

model Class {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  title         String
  description   String?
  createdAt     DateTime  @default(now())


  //relations
  professorId   String    @db.ObjectId
  professor     User      @relation("ProfessorClasses",fields:[professorId], references: [id])

  enrollments ClassEnrollment[]

  // token to join class
  joinToken   String    @unique

  materials   ClassMaterial[]
  // surveys (multiple per class)
  surveys       Survey[]
  studentSurveyResponses StudentSurveyResponse[]

  // Lesson notes in this class
  lessonNotes LessonNote[]

  // Document in this class 
  documents    Document[]
  
  // AI Tutor conversations in this class
  conversations Conversation[]
  
  // Professor quizzes in this class
  professorQuizzes ProfessorQuiz[]
}

model Account {
  id                 String   @id @default(auto()) @map("_id") @db.ObjectId
  userId             String   @db.ObjectId
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt          DateTime @default(now()) @map("created_at")

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String   @unique
  userId       String   @db.ObjectId
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires      DateTime
}

model VerificationToken {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  identifier String
  token      String
  expires    DateTime
 
  @@unique([identifier, token])
}

model ClassEnrollment {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  student   User     @relation(fields: [studentId], references: [id])
  studentId String   @db.ObjectId
  class     Class    @relation(fields: [classId], references: [id])
  classId   String   @db.ObjectId
  joinedAt  DateTime @default(now())

  @@unique([studentId, classId])
}


model ClassMaterial {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  classId        String       @db.ObjectId
  class          Class        @relation(fields: [classId], references: [id])
  title          String
  url            String
  type           MaterialType
  mimeType       String?
  category       MaterialCategory @default(CONTENT)
  uploadedAt     DateTime     @default(now())

  isVectorized   Boolean      @default(false)
  vectorNamespace String?     // e.g., "calculus-101"
  
  // Syllabus processing fields
  extractedText  String?      // Raw extracted text from syllabus
  syllabusProcessed Boolean   @default(false)
  processedAt    DateTime?
  learningObjectives String?  // Structured learning objectives
  courseSchedule String?      // Structured course schedule
  assessmentMethods String?   // Assessment and grading methods
  prerequisites String?       // Course prerequisites
  courseDescription String?     // Course description
  instructorInfo String?      // Instructor information
  gradingPolicy String?       // Grading policies
  processingConfidence Int?   // AI confidence score (0-100)
}


enum MaterialType {
  PDF
  DOCX
  MP4
}

enum MaterialCategory {
  SYLLABUS
  CONTENT
  EXERCISES
}

enum Role {
  STUDENT
  PROFESSOR
  ADMIN
}

model Survey {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  classId        String   @db.ObjectId
  class          Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  title          String
  status         SurveyStatus @default(ARCHIVED)
  questions      Json     // Array of { id, text, type, options?, required, order, duplicatedFrom? }
  publishedAt    DateTime?
  duplicatedFrom String?  @db.ObjectId // Reference to original survey if duplicated
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  // Relations
  responses      StudentSurveyResponse[]
  learningPaths  LearningPathway[]
  
  @@index([classId])
  @@index([status])
}

enum SurveyStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model StudentSurveyResponse {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  studentId  String   @db.ObjectId
  student    User     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  surveyId   String   @db.ObjectId
  survey     Survey   @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  classId    String   @db.ObjectId
  class      Class    @relation(fields: [classId], references: [id], onDelete: Cascade)

  answers    Json     // Array of { questionId, answer }
  submittedAt DateTime @default(now())

  @@unique([studentId, surveyId])
  @@index([surveyId])
  @@index([classId])
}

model LearningPathway {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  studentId  String
  classId    String
  surveyId   String?  @db.ObjectId // Link to the survey used for generation
  survey     Survey?  @relation(fields: [surveyId], references: [id])
  status     String   @default("pending") // "pending" | "approved" | "rejected"
  professorNotes String?  // Optional focus text for regeneration
  approvedAt DateTime?
  rejectedAt DateTime?
  version    Int      @default(1) // For tracking regenerations
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  nodes      PathwayNode[]
  
  @@index([classId])
  @@index([studentId])
  @@index([surveyId])
}

model PathwayNode {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  pathwayId     String   @db.ObjectId
  pathway       LearningPathway @relation(fields: [pathwayId], references: [id], onDelete: Cascade)

  nodeId        String   // This is the Gemini-generated ID (e.g. "node1", "topic_2")
  title         String
  description   String
  type          String   // "topic", "subtopic", "resource", "assessment"
  difficulty    String   // "beginner", "intermediate", "advanced"
  duration      String
  dependsOn     String[] // array of nodeIds it depends on (e.g. ["node1", "node2"])

  // For future expansion
  flashcardsAdded   Boolean @default(false)
  aiLessonComplete  Boolean @default(false)
  quizScore         Int?    // nullable, stores quiz result if applicable

  createdAt     DateTime @default(now())

  // Flashcard relations
  flashcardDeck FlashcardDeck?
  progress      NodeProgress[]

  // Lesson notes attached to this node
  lessonNotes LessonNote[]
  
  // In-Chat Assessments for this node
  inChatAssessments InChatAssessment[]
}

model FlashcardDeck {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  nodeId        String   @unique @db.ObjectId  // References PathwayNode.id
  node          PathwayNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  title         String
  cards         Flashcard[]
  lastGenerated DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Flashcard {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  deckId    String   @db.ObjectId
  deck      FlashcardDeck @relation(fields: [deckId], references: [id], onDelete: Cascade)
  question  String
  answer    String
  hint      String?
  tags      String[] // Array of tags
  order     Int      // For reordering
  type      String   // "concept" or "quiz"
  createdAt DateTime @default(now())
}

model NodeProgress {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  nodeId          String   @db.ObjectId
  node            PathwayNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  studentId       String   @db.ObjectId
  student         User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  flashMasteredIds String[] // Array of flashcard IDs the student has mastered
  quizScore       Int?
  completedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([nodeId, studentId])
}

model LessonNote {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  studentId      String   @db.ObjectId
  student        User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classId        String   @db.ObjectId
  class          Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  pathwayNodeId  String   @db.ObjectId
  node           PathwayNode @relation(fields: [pathwayNodeId], references: [id], onDelete: Cascade)

  // Stable string identifier for the node within the pathway (e.g., "probability_basics")
  nodeKey        String
  title          String?

  // BlockNote document JSON
  content        Json
  contentText    String?
  wordCount      Int?

  // Store an array of AI entries as JSON (we will manage array updates in app logic)
  aiEntries      Json

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([studentId, classId, pathwayNodeId])
}


// Document management
// Content Management Models
model Document {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  type          DocumentType
  url           String
  size          String
  folder        String?  // "recent", "research", "presentations", etc.
  classId       String?  @db.ObjectId  // Optional: link to class
  class         Class?   @relation(fields: [classId], references: [id])
  uploadedBy    String   @db.ObjectId  // User who uploaded
  user          User     @relation("UserDocuments", fields: [uploadedBy], references: [id])
  
  // File metadata
  mimeType      String?
  originalName  String?
  isVectorized  Boolean  @default(false)
  vectorNamespace String?
  
  // Timestamps
  uploadedAt    DateTime @default(now())
  lastModified  DateTime @updatedAt
  
  // Relations
  contentReferences ContentReference[]
  annotations      DocumentAnnotation?
  
  @@index([uploadedBy])
  @@index([classId])
  @@index([folder])
}

model DocumentAnnotation {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  documentId    String   @unique @db.ObjectId
  document      Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  
  // Metadata
  totalNotes    Int      @default(0)
  pagesWithNotes Int[]   // Array of page numbers
  
  // Timestamps
  createdAt     DateTime @default(now())
  lastModified  DateTime @updatedAt
  
  // Note: contentReferences and notes are accessed through the document relation
}

model ContentReference {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  documentId      String   @db.ObjectId
  document        Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  
  // Content identification
  pageNumber      Int
  contentType     ContentType
  contentHash     String   // Hash for reliable identification
  contentPreview  String   // Brief preview text
  
  // Coordinates for highlighting
  coordinates     Json     // { x, y, width, height }
  
  // Timestamps
  timestamp       DateTime @default(now())
  lastModified    DateTime @updatedAt
  
  // Relations
  notes           Note[]
  
  @@index([documentId, pageNumber])
  @@index([contentHash])
}

model Note {
  id                  String   @id @default(auto()) @map("_id") @db.ObjectId
  contentReferenceId  String   @db.ObjectId
  contentReference    ContentReference @relation(fields: [contentReferenceId], references: [id], onDelete: Cascade)
  
  // Note content
  content             String
  tags                String[] // For organization
  color               String?  // Optional color coding
  
  // Timestamps
  timestamp           DateTime @default(now())
  lastModified        DateTime @updatedAt
  
  // Relations
  createdBy           String   @db.ObjectId
  user                User     @relation("UserNotes", fields: [createdBy], references: [id])
  
  @@index([contentReferenceId])
  @@index([createdBy])
  @@index([tags])
}

// Enums
enum DocumentType {
  PDF
  PPTX
  DOCX
  MP4
  IMAGE
}

enum ContentType {
  TEXT
  IMAGE
  DIAGRAM
  SLIDE
  TABLE
  EQUATION
}

// AI Tutor Conversation Models
model Conversation {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  threadId  String    @unique
  userId    String    @db.ObjectId
  classId   String?   @db.ObjectId
  lessonId  String?   @db.ObjectId
  title     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  
  // Relations
  user        User         @relation(fields: [userId], references: [id])
  class       Class?       @relation(fields: [classId], references: [id])
  messages    Message[]
  inChatAssessments InChatAssessment[]
  
  @@map("conversations")
}

model Message {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  conversationId String       @db.ObjectId
  role           MessageRole
  content        String
  sources        Json?       // Source metadata for RAG citations
  timestamp      DateTime     @default(now())
  
  // Relations
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  
  @@map("messages")
}

enum MessageRole {
  USER
  ASSISTANT
}

// In-Chat Assessment Models
model InChatAssessment {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  conversationId String?   @db.ObjectId
  nodeId         String?   @db.ObjectId
  nodeTitle      String?
  topic          String
  fields         Json      // Formedible field configuration
  schema         Json      // Zod schema definition
  correctAnswers Json?     // Correct answers for AI feedback
  createdAt      DateTime  @default(now())
  
  // Relations
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  node           PathwayNode? @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  responses      InChatAssessmentResponse[]
  
  @@index([conversationId])
  @@index([nodeId])
  @@map("in_chat_assessments")
}

model InChatAssessmentResponse {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  assessmentId   String    @db.ObjectId
  studentId      String    @db.ObjectId
  responses      Json      // Student's form responses
  score          Float?    // Calculated score if applicable
  feedback       String?   // AI-generated feedback
  submittedAt     DateTime  @default(now())
  
  // Relations
  assessment     InChatAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  student        User      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  
  @@index([assessmentId])
  @@index([studentId])
  @@map("in_chat_assessment_responses")
}

// Professor Quiz Models
model ProfessorQuiz {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String?
  status      QuizStatus @default(DRAFT)
  classId     String    @db.ObjectId
  class       Class     @relation(fields: [classId], references: [id], onDelete: Cascade)
  professorId String    @db.ObjectId
  professor   User      @relation(fields: [professorId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?
  
  // Relations
  questions   ProfessorQuizQuestion[]
  responses   ProfessorQuizResponse[]
  
  @@index([classId])
  @@index([professorId])
  @@index([status])
  @@map("professor_quizzes")
}

model ProfessorQuizQuestion {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  quizId         String    @db.ObjectId
  quiz           ProfessorQuiz @relation(fields: [quizId], references: [id], onDelete: Cascade)
  text           String    // Rich text content (markdown or BlockNote JSON as string)
  richTextContent Json?   // BlockNote JSON content for rich text editing
  type           QuestionType
  imageUrl       String?   // R2 URL for question image
  order          Int       // Order of question in quiz
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  
  // Relations
  options        ProfessorQuizOption[]
  
  @@index([quizId])
  @@map("professor_quiz_questions")
}

model ProfessorQuizOption {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  questionId String    @db.ObjectId
  question   ProfessorQuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text       String
  isCorrect  Boolean   @default(false)
  order      Int       // Order of option in question
  createdAt  DateTime  @default(now())
  
  @@index([questionId])
  @@map("professor_quiz_options")
}

model ProfessorQuizResponse {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  quizId     String    @db.ObjectId
  quiz       ProfessorQuiz @relation(fields: [quizId], references: [id], onDelete: Cascade)
  studentId  String    @db.ObjectId
  student    User      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  score      Float?    // Calculated score (0-100)
  submittedAt DateTime @default(now())
  
  // Relations
  answers    ProfessorQuizAnswer[]
  
  @@unique([quizId, studentId])
  @@index([quizId])
  @@index([studentId])
  @@map("professor_quiz_responses")
}

model ProfessorQuizAnswer {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  responseId String    @db.ObjectId
  response   ProfessorQuizResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  questionId String    @db.ObjectId
  answerText String?   // For short-answer questions
  optionId   String?   @db.ObjectId // For multiple-choice/true-false questions
  isCorrect  Boolean?  // Whether the answer is correct
  createdAt  DateTime  @default(now())
  
  @@index([responseId])
  @@index([questionId])
  @@map("professor_quiz_answers")
}

enum QuizStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum QuestionType {
  MULTIPLE_CHOICE
  SHORT_ANSWER
  TRUE_FALSE
}

