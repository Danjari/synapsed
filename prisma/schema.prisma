// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init
// after you change this you need to run npx prisma generate 

generator client {
  provider = "prisma-client-js"
  
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  role          Role?
  accounts      Account[]
  sessions      Session[]
  createdAt     DateTime  @default(now()) @map("created_at")

  // relations 

  classesTaught Class[]   @relation("ProfessorClasses")

  enrollments ClassEnrollment[]
}

model Class {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  title         String
  description   String?
  createdAt     DateTime  @default(now())


  //relations
  professorId   String    @db.ObjectId
  professor     User      @relation("ProfessorClasses",fields:[professorId], references: [id])

  enrollments ClassEnrollment[]

  // token to join class
  joinToken   String    @unique

  materials   ClassMaterial[]
}

model Account {
  id                 String   @id @default(auto()) @map("_id") @db.ObjectId
  userId             String   @db.ObjectId
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt          DateTime @default(now()) @map("created_at")

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String   @unique
  userId       String   @db.ObjectId
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires      DateTime
}

model VerificationToken {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  identifier String
  token      String
  expires    DateTime
 
  @@unique([identifier, token])
}

model ClassEnrollment {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  student   User     @relation(fields: [studentId], references: [id])
  studentId String   @db.ObjectId
  class     Class    @relation(fields: [classId], references: [id])
  classId   String   @db.ObjectId
  joinedAt  DateTime @default(now())

  @@unique([studentId, classId])
}


model ClassMaterial {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  classId        String       @db.ObjectId
  class          Class        @relation(fields: [classId], references: [id])
  title          String
  url            String
  type           MaterialType
  mimeType       String?
  uploadedAt     DateTime     @default(now())

  isVectorized   Boolean      @default(false)
  vectorNamespace String?     // e.g., "calculus-101"
}


enum MaterialType {
  PDF
  DOCX
  MP4
}

enum Role {
  STUDENT
  PROFESSOR
  ADMIN
}