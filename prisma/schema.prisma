// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init
// after you change this you need to run npx prisma generate 

generator client {
  provider = "prisma-client-js"
  
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  role          Role?
  accounts      Account[]
  sessions      Session[]
  createdAt     DateTime  @default(now()) @map("created_at")

  // relations 

  classesTaught Class[]   @relation("ProfessorClasses")

  enrollments ClassEnrollment[]

  surveyResponse StudentSurveyResponse?

  // Flashcard progress
  nodeProgress NodeProgress[]

  // Lesson notes authored by the user
  lessonNotes LessonNote[]
}

model Class {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  title         String
  description   String?
  createdAt     DateTime  @default(now())


  //relations
  professorId   String    @db.ObjectId
  professor     User      @relation("ProfessorClasses",fields:[professorId], references: [id])

  enrollments ClassEnrollment[]

  // token to join class
  joinToken   String    @unique

  materials   ClassMaterial[]
  // survey? 
  survey        Survey?
  studentSurveyResponses StudentSurveyResponse[]

  // Lesson notes in this class
  lessonNotes LessonNote[]
}

model Account {
  id                 String   @id @default(auto()) @map("_id") @db.ObjectId
  userId             String   @db.ObjectId
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt          DateTime @default(now()) @map("created_at")

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String   @unique
  userId       String   @db.ObjectId
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires      DateTime
}

model VerificationToken {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  identifier String
  token      String
  expires    DateTime
 
  @@unique([identifier, token])
}

model ClassEnrollment {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  student   User     @relation(fields: [studentId], references: [id])
  studentId String   @db.ObjectId
  class     Class    @relation(fields: [classId], references: [id])
  classId   String   @db.ObjectId
  joinedAt  DateTime @default(now())

  @@unique([studentId, classId])
}


model ClassMaterial {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  classId        String       @db.ObjectId
  class          Class        @relation(fields: [classId], references: [id])
  title          String
  url            String
  type           MaterialType
  mimeType       String?
  uploadedAt     DateTime     @default(now())

  isVectorized   Boolean      @default(false)
  vectorNamespace String?     // e.g., "calculus-101"
}


enum MaterialType {
  PDF
  DOCX
  MP4
}

enum Role {
  STUDENT
  PROFESSOR
  ADMIN
}

model Survey {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  classId   String   @unique @db.ObjectId
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  questions Json     // Array of { id, text, type, options? }
  createdAt DateTime @default(now())
}

model StudentSurveyResponse {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  studentId  String   @unique @db.ObjectId
  student    User     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  classId    String   @db.ObjectId
  class      Class    @relation(fields: [classId], references: [id], onDelete: Cascade)

  answers    Json     // Array of { questionId, answer }
  submittedAt DateTime @default(now())

  @@unique([studentId, classId])
}

model LearningPathway {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  studentId  String
  classId    String
  status     String   @default("pending") // or "approved"
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  nodes      PathwayNode[]
}

model PathwayNode {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  pathwayId     String   @db.ObjectId
  pathway       LearningPathway @relation(fields: [pathwayId], references: [id], onDelete: Cascade)

  nodeId        String   // This is the Gemini-generated ID (e.g. "node1", "topic_2")
  title         String
  description   String
  type          String   // "topic", "subtopic", "resource", "assessment"
  difficulty    String   // "beginner", "intermediate", "advanced"
  duration      String
  dependsOn     String[] // array of nodeIds it depends on (e.g. ["node1", "node2"])

  // For future expansion
  flashcardsAdded   Boolean @default(false)
  aiLessonComplete  Boolean @default(false)
  quizScore         Int?    // nullable, stores quiz result if applicable

  createdAt     DateTime @default(now())

  // Flashcard relations
  flashcardDeck FlashcardDeck?
  progress      NodeProgress[]

  // Lesson notes attached to this node
  lessonNotes LessonNote[]
}

model FlashcardDeck {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  nodeId        String   @unique @db.ObjectId  // References PathwayNode.id
  node          PathwayNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  title         String
  cards         Flashcard[]
  lastGenerated DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Flashcard {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  deckId    String   @db.ObjectId
  deck      FlashcardDeck @relation(fields: [deckId], references: [id], onDelete: Cascade)
  question  String
  answer    String
  hint      String?
  tags      String[] // Array of tags
  order     Int      // For reordering
  type      String   // "concept" or "quiz"
  createdAt DateTime @default(now())
}

model NodeProgress {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  nodeId          String   @db.ObjectId
  node            PathwayNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  studentId       String   @db.ObjectId
  student         User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  flashMasteredIds String[] // Array of flashcard IDs the student has mastered
  quizScore       Int?
  completedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([nodeId, studentId])
}

model LessonNote {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  studentId      String   @db.ObjectId
  student        User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classId        String   @db.ObjectId
  class          Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  pathwayNodeId  String   @db.ObjectId
  node           PathwayNode @relation(fields: [pathwayNodeId], references: [id], onDelete: Cascade)

  // Stable string identifier for the node within the pathway (e.g., "probability_basics")
  nodeKey        String
  title          String?

  // BlockNote document JSON
  content        Json
  contentText    String?
  wordCount      Int?

  // Store an array of AI entries as JSON (we will manage array updates in app logic)
  aiEntries      Json

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([studentId, classId, pathwayNodeId])
}

